# Server
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://philosophy:philosophy@localhost:5432/philosophy

# JWT（随机字符串，不要用 bcrypt 哈希！含 $ 字符请加双引号）
JWT_SECRET="your-random-secret-at-least-32-chars"
JWT_EXPIRES_IN=7d

# 管理员账号（首次 seed 时创建；之后改密码请运行 yarn workspace @philosophy/api reset-admin）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Public API URL for avatar links (required in production)
PUBLIC_API_URL=http://localhost:3000

# CORS: comma-separated origins, or leave empty for allow-all in dev
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080
