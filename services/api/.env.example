# Server
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://philosophy:philosophy@localhost:5432/philosophy

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Initial admin (seeded on first run if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Public API URL for avatar links (required in production)
PUBLIC_API_URL=http://localhost:3000

# CORS: comma-separated origins, or leave empty for allow-all in dev
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080
