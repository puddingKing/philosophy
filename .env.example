POSTGRES_USER=philosophy
POSTGRES_PASSWORD=请改为强密码
POSTGRES_DB=philosophy

JWT_SECRET=请用 openssl rand -base64 32 生成
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改为强密码

# 你的域名（路径方案：/api 和 /admin 同域）
PUBLIC_API_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com
